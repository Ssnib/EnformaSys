# EnformaSys Environment Template
# Copy this file to .env or .env.local (never commit .env files)

APP_ENV=production
APP_URL=https://enformasys.vercel.app
ALLOWED_ORIGINS=https://enformasys.vercel.app

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=seminary_db
DB_USER=enformasys_app
DB_PASS=change_me_strong_password
DB_SSL=false
DB_SSL_CA=ca.pem

SESSION_LIFETIME=3600
ALLOW_DEFAULT_SEED=false
DEFAULT_SEED_PASSWORD=
ADMIN_INITIAL_PASSWORD=
